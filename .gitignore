# Keep version control confined to the project's reproducible source package.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CMakeLists.txt
!/CFL3D_MAPPING.md
!/CFL3D_NOZZLE_TASK_DEFINITION.md
!/src/
!/reference/
!/tests/
!/cases/
!/scripts/
!/docs/
!/.github/
!/output/

# Generated results stay local; retain only the small audit essentials.
/output/*
!/output/muscl_repair/
/output/muscl_repair/*
!/output/muscl_repair/legacy/
/output/muscl_repair/legacy/*
!/output/muscl_repair/legacy/nozzle_solver.cpp
!/output/muscl_repair/legacy/mesh_geometry.hpp
!/output/muscl_repair/validation_metrics.csv
!/output/muscl_repair/validation_table.md
!/output/muscl_repair/residual_comparison.png
!/output/muscl_repair/flow_comparison.png
!/output/muscl_repair/mach_fields.png
!/output/muscl_repair/entropy_wave_accuracy.png

__pycache__/
*.py[cod]
*.o
*.a
*.so
*.log
.env
.env.*
*.pem
*.key
.DS_Store
*~
